+def coerce_param_value(value: str, declared=None):
+    """Convert only values compatible with a declared JSON type; preserve failures verbatim."""
+    types = declared if isinstance(declared, list) else [declared]
+    if types == ["string"]:
+        return value
+    v = value.strip()
+    low = v.lower()
+    if not declared:
+        try:
+            return json.loads(v)
+        except ValueError:
+            if low in ("true", "false"):
+                return low == "true"
+            if low in ("null", "none"):
+                return None
+            return v
+    if "boolean" in types and low in ("true", "false"):
+        return low == "true"
+    if "null" in types and low in ("null", "none"):
+        return None
+    if ("integer" in types or "number" in types) and re.fullmatch(
+        r"[+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+)(?:[eE][+-]?[0-9]+)?", v
+    ):
+        try:
+            n = Decimal(v)
+        except ArithmeticError:
+            return value
+        if "integer" in types and n == n.to_integral_value():
+            # Stay within Python's JSON integer serialization limit, including exponent notation.
+            limit = sys.get_int_max_str_digits()
+            if limit and n.adjusted() >= limit:
+                return value
+            return int(n)
+        if "number" in types:
+            number = float(n)
+            if math.isfinite(number):
+                return int(v) if re.fullmatch(r"[+-]?[0-9]+", v) else number
+    if "object" in types or "array" in types:
+        try:
+            decoded = json.loads(v)
+        except ValueError:
+            try:
+                decoded = ast.literal_eval(v)
+            except (ValueError, SyntaxError, TypeError, RecursionError):
+                return value
+        # literal_eval also accepts sets, tuples and non-string dictionary keys.
+        # Only JSON-compatible trees may become tool arguments.
+        def json_value(item):
+            if item is None or type(item) in (str, bool, int):
+                return True
+            if type(item) is float:
+                return math.isfinite(item)
+            if type(item) is list:
+                return all(json_value(x) for x in item)
+            if type(item) is dict:
+                return all(isinstance(k, str) and json_value(x) for k, x in item.items())
+            return False
+        if (("object" in types and isinstance(decoded, dict)) or
+                ("array" in types and isinstance(decoded, list))) and json_value(decoded):
+            return decoded
+    return value
