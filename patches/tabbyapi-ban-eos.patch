diff --git a/backends/exllamav3/stop_conditions.py b/backends/exllamav3/stop_conditions.py
new file mode 100644
--- /dev/null
+++ b/backends/exllamav3/stop_conditions.py
@@ -0,0 +1,9 @@
+"""Build per-request ExLlamaV3 stop conditions without mutating sampler input."""
+
+
+def build_stop_conditions(user_stops, hf_eos_tokens, backend_eos_tokens, ban_eos_token):
+    stops = list(user_stops or [])
+    if not ban_eos_token:
+        stops.extend(hf_eos_tokens)
+        stops.extend(backend_eos_tokens)
+    return list(set(stops))
